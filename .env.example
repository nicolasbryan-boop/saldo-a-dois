# ---------------------------------------------------------------------------
# Saldo a Dois — environment variables
# ---------------------------------------------------------------------------
# Local development with `next dev` reads .env.local.
# Cloudflare Workers (wrangler dev / deploy) reads .dev.vars locally and
# `wrangler secret put` values in preview/production. See .dev.vars.example.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# development | preview | production
APP_ENV=development
# Public origin of the app. Used by Better Auth and by checkout return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (REQUIRED) --------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Admin ------------------------------------------------------------------
# Comma-separated list of e-mails allowed into /admin.
ADMIN_EMAILS=

# --- AI provider ------------------------------------------------------------
# workers-ai | openai | anthropic | gemini | none
AI_PROVIDER=workers-ai
# Only used when AI_PROVIDER=workers-ai and you are NOT running on Workers
# (i.e. `next dev`). Leave empty to disable the LLM fallback in plain Node dev.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Payments ---------------------------------------------------------------
# mock | stripe   ("mock" is refused at runtime when APP_ENV=production)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Um Price ID recorrente por plano, criados no painel do Stripe.
#   Mensal     R$ 20,90  a cada 1 mes
#   Trimestral R$ 54,90  a cada 3 meses
#   Anual      R$ 229,90 a cada 12 meses
# Um plano sem Price ID e recusado no checkout, nomeando a variavel que falta.
STRIPE_PRICE_MONTHLY_ID=
STRIPE_PRICE_QUARTERLY_ID=
STRIPE_PRICE_YEARLY_ID=

# --- Mercado Pago (checkout transparente: Pix + cartão, sem sair do site) ---
# Só usadas quando PAYMENT_PROVIDER=mercadopago. Nenhuma conta está conectada
# hoje; enquanto estas estiverem vazias o provider recusa cobrar e diz qual
# variável falta, em vez de adivinhar.
#   Access Token  -> Suas integrações > Credenciais (começa com APP_USR- ou TEST-)
#   Public Key    -> mesma tela; é a única que pode aparecer no HTML
#   Webhook secret-> Webhooks > Assinatura secreta
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# --- E-mail -----------------------------------------------------------------
# console | resend   ("console" writes to the dev outbox, sends nothing)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Saldo a Dois <nao-responda@example.com>"

# --- Seed -------------------------------------------------------------------
# Password given to the demo users created by `npm run db:seed`.
SEED_PASSWORD=demo123456
