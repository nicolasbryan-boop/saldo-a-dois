{
  "name": "saldo-a-dois",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply saldo-a-dois-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply saldo-a-dois-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "cf:build": "npm run cf:typegen && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview -- --env preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy -- --env production",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "icons": "node scripts/generate-icons.mjs",
    "db:migrate:preview": "wrangler d1 migrations apply saldo-a-dois-db-preview --remote --env preview",
    "auth:schema": "npx --yes auth@1.7.1 generate --config scripts/auth-schema-config.ts --output .auth-schema-reference.ts --yes",
    "smoke": "bash scripts/smoke.sh",
    "browser:check": "node scripts/browser-check.mjs",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@better-auth/core": "^1.7.1",
    "better-auth": "^1.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
